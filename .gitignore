# Build outputs: regenerated by `python -m build` / `pip install`; committing
# them ships stale copies of the source and confuses reviewers and packagers.
build/
dist/
*.egg-info/
# Python bytecode and local environments
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
# Playground wire logs written by `a2aops play`
a2aops-session.jsonl
